generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id        String   @id @default(cuid())
  nitradoId String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  killsPvp            Int   @default(0)
  deathsPvp           Int   @default(0)
  deathsPve           Int   @default(0)
  deathsSuicide       Int   @default(0)
  kdRatio             Float @default(0)
  currentKillstreak   Int   @default(0)
  bestKillstreak      Int   @default(0)
  longestKillDistance Float @default(0)
  totalSecondsOnline  Int   @default(0)

  killsAsKiller      KillEvent[]        @relation("Killer")
  killsAsVictim      KillEvent[]        @relation("Victim")
  sessions           Session[]
  leaderboardEntries LeaderboardEntry[]
}

model KillEvent {
  id        String   @id @default(cuid())
  timestamp DateTime

  killer   Player @relation("Killer", fields: [killerId], references: [id])
  killerId String

  victim   Player @relation("Victim", fields: [victimId], references: [id])
  victimId String

  weapon       String
  ammoType     String?
  distance     Float
  fatalHitZone String?

  killedPosX Float
  killedPosY Float
  killedPosZ Float

  killerPosX Float
  killerPosY Float
  killerPosZ Float

  locationName       String?
  killerStreakAtKill Int     @default(0)

  createdAt DateTime @default(now())

  @@index([killerId])
  @@index([victimId])
  @@index([timestamp])
}

model Session {
  id       String @id @default(cuid())
  player   Player @relation(fields: [playerId], references: [id])
  playerId String

  connectedAt     DateTime
  disconnectedAt  DateTime?
  durationSeconds Int?

  @@index([playerId])
}

model LeaderboardEntry {
  id       String @id @default(cuid())
  player   Player @relation(fields: [playerId], references: [id])
  playerId String

  periodStart DateTime
  periodEnd   DateTime?

  kills               Int   @default(0)
  deaths              Int   @default(0)
  bestKillstreak      Int   @default(0)
  longestKillDistance Float @default(0)
  totalSecondsOnline  Int   @default(0)

  createdAt DateTime @default(now())

  @@index([playerId])
  @@index([periodStart])
}
